# Environment variables for Mello Code API

# AI Provider: 'openai', 'openai-compatible', or 'local-ollama'
AI_PROVIDER=openai

# API Key for your AI provider
API_KEY=your_api_key_here

# Base URL for OpenAI-compatible providers
BASE_URL=https://api.openai.com/v1

# Model name
MODEL=gpt-4o-mini

# Port
PORT=3001
